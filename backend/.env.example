DATABASE_URL=postgresql://kullanici:sifre@localhost:5432/kantin_pos?schema=public
JWT_SECRET=degistirilecek-gizli-anahtar
PORT=3001

# Windows örneği: C:\Program Files\PostgreSQL\17\bin\pg_dump.exe
# Boş bırakılırsa PATH üzerindeki pg_dump kullanılır.
PG_DUMP_PATH=

# Electron production: kullanıcı verisi (uploads/backups/logs/config)
# ELECTRON_USER_DATA_PATH=%APPDATA%\Kantin POS
# Tercih edilen env dosyası: %APPDATA%\Kantin POS\config\.env

